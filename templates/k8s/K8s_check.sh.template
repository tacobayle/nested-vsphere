#!/bin/bash
retry=30
pause=30
attempt=0
expected_node_ready=${total_node}
echo "############################################################################################"
while [ ${attempt} -ne ${retry} ]; do
  IFS=$'\n'
  nodes_ready=0
  for index_node in $(seq 0 $((expected_node_ready-1)))
  do
    if [[ $(kubectl get nodes -o json 2> /dev/null | jq -c -r '.items['${index_node}'].status.conditions[] | select(.type == "Ready").status') == "True" ]]; then
      ((nodes_ready++))
    fi
  done
  if [ ${nodes_ready} -eq ${expected_node_ready} ] ; then
    echo "Amount of nodes READY: $nodes_ready - PASSED"
    if [ -z "${SLACK_WEBHOOK_URL}" ] ; then echo "ignoring slack update" ; else curl -X POST -H 'Content-type: application/json' --data '{"text":"'$(date "+%Y-%m-%d,%H:%M:%S")', ${deployment_name}: k8s cluster ${clusterName} is ready"}' ${SLACK_WEBHOOK_URL} >/dev/null 2>&1; fi
    exit
  else
    echo "Amount of nodes READY: ${nodes_ready}, expected: ${expected_node_ready} - RETRY"
    ((attempt++))
    sleep $pause
  fi
done
echo "ERROR: unable to get all the nodes READY after ${attempt} attempts"
exit